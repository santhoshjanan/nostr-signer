{
  "name": "nostr-signer",
  "version": "0.1.0",
  "private": true,
  "description": "Personal NIP-46 Nostr remote signer (bunker) for Windows",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.node.json tsconfig.web.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "dist": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "nostr-tools": "2.17.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.5",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "38.0.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "dev.nostrsigner.app",
    "productName": "Nostr Signer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "asar": false
  }
}
